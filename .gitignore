# Optional local Tauri logs
src-tauri/*.log

# macOS system files
.AppleDouble
.LSOverride
Icon?
# `Icon?` also matches the directory name `icons` on case-insensitive macOS
# filesystems. Keep the Tauri bundle icons required by tauri.conf.json in Git.
!src-tauri/icons/
src-tauri/icons/**
!src-tauri/icons/32x32.png
!src-tauri/icons/128x128.png
!src-tauri/icons/128x128@2x.png
!src-tauri/icons/icon.icns
!src-tauri/icons/icon.ico
._*
.Spotlight-V100
.Trashes

